@startuml act_01_Registrasi_Akun
skinparam Style strictuml
skinparam ActivityFontName Times New Roman
skinparam ActivityFontSize 12
skinparam ActivityBorderColor Black
skinparam ActivityBackgroundColor White
skinparam ArrowColor Black
skinparam ArrowFontName Times New Roman
skinparam ArrowFontSize 10
skinparam SwimlaneBorderColor Black
skinparam SwimlaneTitleFontName Times New Roman
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold

|Pelanggan|
start
:Membuka Halaman Registrasi;

|Sistem|
:Menampilkan Formulir Registrasi;

|Pelanggan|
:Mengisi Data Diri\n(Nama, Email, No HP, Alamat, Password);
:Klik Tombol "Daftar";

|Sistem|
:Melakukan Validasi Kredensial Data;
if (Data Valid?) then (Ya)
  :Menyimpan Data Customer Baru ke Basis Data;
  :Melakukan Otentikasi & Auto-Login Sesi;
  :Mengarahkan ke Halaman Dasbor Customer;
  |Pelanggan|
  :Menampilkan Halaman Dasbor;
  stop
else (Tidak)
  |Sistem|
  :Mengarahkan Kembali ke Formulir Registrasi;
  :Menampilkan Pesan Kesalahan / Validasi Error;
  |Pelanggan|
  :Melihat Pesan Error & Memperbaiki Input;
  stop
endif
@enduml
