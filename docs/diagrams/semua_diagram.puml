@startuml 09_Review_Desain
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Admin" as Admin
actor "Pelanggan" as Customer
boundary "Detail Pesanan / Timeline" as View
control "Kontroler Pesanan" as Controller
database "Basis Data" as DB

Admin -> View : Memeriksa detail desain pesanan

alt [Perlu Direvisi (Admin)]
    Admin -> View : Mengetik pesan revisi & lampirkan gambar
    View -> Controller : Mengirim data revisi
    activate Controller
    Controller -> DB : Menyimpan pesan di tabel OrderRevision
    Controller -> DB : Memperbarui status desain pesanan menjadi "revisi"
    Controller --> View : Mengarahkan kembali dengan pesan sukses
    deactivate Controller
end

Customer -> View : Membuka detail pesanan
View --> Customer : Menampilkan timeline & pesan revisi dari Admin

alt [Mengirim Perbaikan (Customer)]
    Customer -> View : Mengetik balasan & unggah desain baru
    View -> Controller : Mengirim data revisi
    activate Controller
    Controller -> DB : Menyimpan balasan di tabel OrderRevision
    Controller --> View : Mengarahkan kembali
    deactivate Controller
end

alt [Desain Disetujui Akhir (Admin)]
    Admin -> View : Klik "Setujui Desain"
    View -> Controller : Mengirim status disetujui
    activate Controller
    Controller -> DB : Memperbarui status desain menjadi "disetujui"
    Controller --> View : Mengarahkan kembali
    deactivate Controller
end
@enduml

@startuml 10_Kelola_Pesanan
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Admin" as Admin
boundary "Manajemen Pesanan" as View
control "Kontroler Pesanan" as Controller
database "Basis Data" as DB

Admin -> View : Melihat tabel pesanan masuk

alt [Bukti Tidak Valid]
    Admin -> View : Memilih status "Dibatalkan"
    View -> Controller : Mengirim pembaruan status
    activate Controller
    Controller -> DB : Memperbarui pesanan dibatalkan
    Controller --> View : Mengarahkan kembali
    deactivate Controller
else [Bukti Valid]
    Admin -> View : Memilih status "Diproses"
    View -> Controller : Mengirim pembaruan status
    activate Controller
    Controller -> DB : Memperbarui pesanan diproses
    Controller --> View : Mengarahkan kembali
    deactivate Controller
end

Admin -> View : Memperbarui jadi Selesai/Dikirim
View -> Controller : Mengirim pembaruan status selesai
activate Controller
Controller -> DB : Memperbarui pesanan selesai
Controller --> View : Mengarahkan kembali
deactivate Controller
@enduml

