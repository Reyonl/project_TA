boundary "Halaman Riwayat" as View
control "Kontroler Pesanan" as Controller
database "Basis Data" as DB

Customer -> View : Membuka riwayat pesanan
View -> Controller : Meminta riwayat pesanan
activate Controller
Controller -> DB : Mengambil data pesanan
activate DB
DB --> Controller : Data riwayat pesanan
deactivate DB
Controller --> View : Menampilkan daftar pesanan
deactivate Controller

Customer -> View : Klik detail pesanan
View -> Controller : Meminta detail pesanan
activate Controller
Controller -> DB : Mengambil detail & status
activate DB
