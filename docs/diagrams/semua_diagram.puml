@startuml 01_Registrasi_Akun
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pelanggan" as Customer
boundary "Halaman Registrasi" as View
control "Kontroler Registrasi" as Controller
database "Basis Data\n(Pelanggan)" as DB

Customer -> View : Membuka halaman registrasi
View --> Customer : Menampilkan formulir registrasi
Customer -> View : Mengisi formulir data diri
Customer -> View : Klik tombol "Daftar"
View -> Controller : Mengirim data pendaftaran
activate Controller

Controller -> Controller : Melakukan validasi data

alt [Data Tidak Valid]
    Controller --> View : Mengarahkan dengan pesan kesalahan
    View --> Customer : Menampilkan pesan kesalahan
else [Data Valid]
    Controller -> DB : Menyimpan data ke basis data
    activate DB
    DB --> Controller : Data tersimpan
    deactivate DB
    Controller -> Controller : Melakukan otentikasi (login)
    Controller --> View : Mengarahkan ke halaman dasbor
    View --> Customer : Menampilkan halaman dasbor
end
deactivate Controller
@enduml

@startuml 02_Membuat_Desain
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Pelanggan" as Customer
boundary "Editor Desain" as View
control "Kontroler Desain" as Controller
boundary "Penyimpanan\n(Storage)" as Storage
database "Basis Data" as DB

Customer -> View : Membuka Editor Desain
Customer -> View : Langkah 1: Memilih Warna Pakaian
Customer -> View : Langkah 2 & 3: Membuat Desain Depan/Belakang
Customer -> View : Langkah 4: Tinjau Desain & Harga
Customer -> View : Klik "Simpan Desain"
View -> Controller : Mengirim data gambar Base64 (Depan & Belakang)
activate Controller
Controller -> Controller : Menerjemahkan data Base64
Controller -> Storage : Mengunggah file gambar mockup
activate Storage
Storage --> Controller : Mengembalikan lokasi gambar
deactivate Storage
Controller -> DB : Menyimpan data desain & menambah ke keranjang
activate DB
DB --> Controller : Data tersimpan
deactivate DB
Controller --> View : Mengembalikan status sukses & ID Desain
deactivate Controller
View --> Customer : Mengarahkan ke halaman Keranjang
@enduml

@startuml 03_Kelola_Keranjang
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Pelanggan" as Customer
boundary "Halaman Keranjang" as View
control "Kontroler Keranjang" as Controller
database "Basis Data\n(Keranjang)" as DB

Customer -> View : Membuka keranjang
View -> Controller : Meminta data keranjang
activate Controller
Controller -> DB : Mengambil data keranjang
activate DB
DB --> Controller : Data keranjang belanja
deactivate DB
Controller --> View : Menampilkan keranjang
deactivate Controller

alt [Hapus Barang]
    Customer -> View : Klik "Hapus"
    View -> Controller : Meminta penghapusan data
    activate Controller
    Controller -> DB : Menghapus data keranjang
    Controller --> View : Mengarahkan kembali
    deactivate Controller
else [Lanjut Checkout]
    Customer -> View : Klik "Checkout"
    View -> Controller : Mengarahkan ke halaman Checkout
end
@enduml

@startuml 04_Checkout_Pesanan
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Pelanggan" as Customer
boundary "Halaman Checkout" as View
control "Kontroler Checkout" as Controller
boundary "Penyimpanan\n(Storage)" as Storage
database "Basis Data\n(Pesanan)" as DB

Customer -> View : Mengunggah bukti & klik buat pesanan
View -> Controller : Mengirim bukti pembayaran
activate Controller
Controller -> Controller : Memvalidasi file gambar
Controller -> Storage : Mengunggah bukti pembayaran
activate Storage
Storage --> Controller : Mengembalikan lokasi bukti
deactivate Storage
Controller -> DB : Memulai Transaksi Basis Data
activate DB
Controller -> DB : Menyimpan data pesanan & detail
Controller -> DB : Menghapus data dari keranjang
DB --> Controller : Menyelesaikan Transaksi
deactivate DB
Controller --> View : Mengarahkan ke halaman Riwayat
deactivate Controller
@enduml

