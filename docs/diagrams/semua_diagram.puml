Admin -> View : Mengakses menu kelola produk
View -> Controller : Meminta daftar master produk
activate Controller
Controller -> DB : Mengambil semua data produk
activate DB
DB --> Controller : Data produk
deactivate DB
Controller --> View : Menampilkan tabel master produk
deactivate Controller

alt [Tambah / Ubah Data Produk]
    Admin -> View : Mengisi formulir (nama, jenis, tipe, harga, deskripsi) & upload gambar
    View -> Controller : Mengirim data formulir produk
    activate Controller
    Controller -> Controller : Memvalidasi input data
    opt [Terdapat File Gambar Baru]
