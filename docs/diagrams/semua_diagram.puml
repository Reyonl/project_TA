@startuml 01_Registrasi_Akun
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pelanggan" as Customer
boundary "Halaman Registrasi" as View
control "Kontroler Registrasi" as Controller
entity "Basis Data\n(customers)" as DB

Customer -> View : Membuka halaman registrasi
View --> Customer : Menampilkan formulir pendaftaran
Customer -> View : Mengisi data diri (nama, email, no_hp, alamat, password)
Customer -> View : Klik tombol "Daftar"
View -> Controller : Mengirim data pendaftaran
activate Controller

Controller -> Controller : Melakukan validasi data input

alt [Data Tidak Valid]
    Controller --> View : Mengembalikan pesan kesalahan validasi
    View --> Customer : Menampilkan pesan error pada formulir
else [Data Valid]
    Controller -> DB : Menyimpan entitas profil ke tabel customers
    activate DB
    DB --> Controller : Data tersimpan
    deactivate DB
    Controller -> Controller : Melakukan autentikasi otomatis (Auto-login)
    Controller --> View : Mengarahkan ke halaman dasbor / katalog
    View --> Customer : Menampilkan dasbor pelanggan dengan notifikasi sukses
end
deactivate Controller
@enduml

@startuml 06_Login
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pengguna\n(Customer/Admin/Owner)" as Actor
boundary "Halaman Masuk (Login)" as View
control "Kontroler Otentikasi" as Controller
entity "Basis Data\n(customers / admins)" as DB

Actor -> View : Membuka halaman login
View --> Actor : Menampilkan formulir login
Actor -> View : Memasukkan email & kata sandi
Actor -> View : Klik tombol "Masuk"
View -> Controller : Mengirimkan kredensial login
activate Controller

Controller -> DB : Mencocokkan kredensial (guard 'customer' / 'admin')
activate DB
DB --> Controller : Hasil verifikasi kredensial
deactivate DB

alt [Kredensial Tidak Valid]
    Controller --> View : Mengembalikan pesan kesalahan kredensial
    View --> Actor : Menampilkan pesan error "Kredensial tidak valid"
else [Kredensial Valid]
    Controller -> Controller : Membuat sesi login pengguna yang sah
    Controller --> View : Mengarahkan ke dasbor sesuai hak akses (Role)
    View --> Actor : Menampilkan halaman tujuan (Katalog / Dasbor Admin / Laporan Owner)
end
deactivate Controller
@enduml

@startuml 02_Membuat_Desain
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pelanggan" as Customer
boundary "Editor Desain" as View
control "Kontroler Desain" as Controller
boundary "Penyimpanan\n(Storage)" as Storage
entity "Basis Data\n(desains & carts)" as DB

Customer -> View : Membuka Editor Desain pada produk terpilih
Customer -> View : Step 1: Memilih warna dasar pakaian
Customer -> View : Step 2-5: Menambahkan teks, gambar kustom, stiker (Depan, Belakang, Sisi)
Customer -> View : Step Review: Memeriksa preview mockup gabungan & rincian sablon
Customer -> View : Klik "Simpan Desain & Lanjut ke Keranjang"
View -> Controller : Mengirim payload (Base64 mockup, JSON canvas state, raw assets)
activate Controller

Controller -> Controller : Menerjemahkan data Base64 gambar
Controller -> Storage : Menyimpan file gambar mockup & raw assets ke disk publik
activate Storage
Storage --> Controller : Mengembalikan path lokasi file
deactivate Storage

Controller -> DB : Menyimpan data desain ke tabel desains (+ canvas JSON)
activate DB
Controller -> DB : Menambahkan item baru ke tabel carts
DB --> Controller : Data desain & keranjang tersimpan
deactivate DB

Controller --> View : Mengembalikan response JSON sukses & ID Desain
deactivate Controller
View --> Customer : Mengarahkan pelanggan ke Halaman Keranjang Belanja
@enduml

@startuml 03_Kelola_Keranjang
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pelanggan" as Customer
boundary "Halaman Keranjang" as View
control "Kontroler Keranjang" as Controller
entity "Basis Data\n(carts)" as DB

Customer -> View : Membuka menu keranjang belanja
View -> Controller : Meminta data keranjang milik pelanggan
activate Controller
Controller -> DB : Mengambil data keranjang beserta relasi produk & desain
activate DB
DB --> Controller : Data keranjang belanja
deactivate DB
Controller --> View : Menampilkan rincian item, kuantitas, & subtotal harga
deactivate Controller

alt [Ubah Kuantitas Item]
    Customer -> View : Mengubah kuantitas item (+ / -)
    View -> Controller : Request update kuantitas (id_cart, quantity)
    activate Controller
    Controller -> DB : Memperbarui kuantitas di tabel carts
    Controller --> View : Memperbarui subtotal & ringkasan belanja
    deactivate Controller
else [Hapus Item Keranjang]
    Customer -> View : Klik tombol ikon "Hapus" pada item
    View -> Controller : Request penghapusan item (id_cart)
    activate Controller
    Controller -> DB : Menghapus data item dari tabel carts
    Controller --> View : Memperbarui daftar item & total belanja
    deactivate Controller
else [Lanjut ke Checkout]
    Customer -> View : Memilih centang item & Klik "Checkout"
    View -> Controller : Mengarahkan ke halaman checkout dengan parameter cart_ids[]
end
@enduml

@startuml 04_Checkout_Pesanan
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pelanggan" as Customer
boundary "Halaman Checkout" as View
control "Kontroler Checkout" as Controller
entity "Basis Data\n(orders & order_details)" as DB

Customer -> View : Mengakses halaman checkout dengan item terpilih
View -> Controller : Meminta rincian item & kalkulasi total tagihan
activate Controller
Controller -> DB : Mengambil data item terpilih dari tabel carts
activate DB
DB --> Controller : Data produk & desain
deactivate DB
Controller --> View : Menampilkan ringkasan pesanan & rincian total pembayaran
deactivate Controller

Customer -> View : Memeriksa rincian & Klik tombol "Buat Pesanan"
View -> Controller : Mengirim formulir konfirmasi pesanan (cart_ids[])
activate Controller

Controller -> DB : Memulai Transaksi Basis Data (DB::transaction)
activate DB
Controller -> DB : Menyimpan data pesanan baru ke tabel orders\n(status_order: 'reviewing', payment_status: 'unpaid')
Controller -> DB : Menyimpan rincian item ke tabel order_details\n(status_desain: 'pending')
Controller -> DB : Menghapus item terpilih dari tabel carts
DB --> Controller : Transaksi sukses & data pesanan tersimpan
deactivate DB

Controller --> View : Mengarahkan ke halaman riwayat pesanan dengan flash message sukses
deactivate Controller
View --> Customer : Menampilkan notifikasi pesanan berhasil dibuat\n(Menunggu Review Desain oleh Admin)
@enduml

@startuml 05_Lacak_Pesanan
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pelanggan" as Customer
boundary "Halaman Riwayat & Detail" as View
control "Kontroler Pesanan" as Controller
boundary "Penyimpanan\n(Storage)" as Storage
entity "Basis Data\n(orders)" as DB

Customer -> View : Membuka menu riwayat pesanan saya
View -> Controller : Meminta daftar seluruh riwayat pesanan
activate Controller
Controller -> DB : Mengambil daftar pesanan milik pelanggan
activate DB
DB --> Controller : Data riwayat transaksi
deactivate DB
Controller --> View : Menampilkan tabel riwayat pesanan & label status
deactivate Controller

Customer -> View : Klik salah satu pesanan untuk melihat detail
View -> Controller : Meminta data detail pesanan (id_order)
activate Controller
Controller -> DB : Mengambil rincian item, status desain, dan status pembayaran
activate DB
DB --> Controller : Data detail pesanan lengkap
deactivate DB
Controller --> View : Menampilkan detail pesanan & instruksi status
deactivate Controller

opt [Kondisi: Pesanan Berstatus 'awaiting_payment' (Desain Telah Disetujui)]
    Customer -> View : Mengunggah file bukti transfer bank & klik "Kirim Bukti"
    View -> Controller : Mengirim file bukti pembayaran
    activate Controller
    Controller -> Controller : Memvalidasi berkas gambar (JPG/PNG, max 2MB)
    Controller -> Storage : Menyimpan file ke direktori bukti_pembayaran/
    activate Storage
    Storage --> Controller : Mengembalikan path lokasi berkas
    deactivate Storage
    Controller -> DB : Memperbarui bukti_pembayaran & payment_status = 'awaiting_verification'
    activate DB
    DB --> Controller : Data pembayaran terupdate
    deactivate DB
    Controller --> View : Mengarahkan kembali dengan notifikasi sukses upload
    deactivate Controller
    View --> Customer : Menampilkan pesan bukti bayar berhasil diunggah\n(Menunggu Verifikasi Admin)
end
@enduml

@startuml 07_Kelola_Produk
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Admin" as Admin
boundary "Halaman Produk" as View
control "Kontroler Produk" as Controller
boundary "Penyimpanan\n(Storage)" as Storage
