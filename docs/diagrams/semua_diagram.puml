@enduml

@startuml 06_Login
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Pengguna" as Actor
boundary "Halaman Masuk (Login)" as View
control "Kontroler Otentikasi" as Controller
database "Basis Data" as DB

Actor -> View : Membuka formulir masuk
Actor -> View : Mengisi email & kata sandi
View -> Controller : Mengirim data masuk
activate Controller
Controller -> DB : Memeriksa kredensial
activate DB
DB --> Controller : Hasil pemeriksaan
deactivate DB

alt [Gagal]
    Controller --> View : Pesan kesalahan kredensial
else [Berhasil]
    Controller -> Controller : Menyimpan sesi pengguna
    Controller --> View : Mengarahkan ke Dasbor
end
deactivate Controller
@enduml

@startuml 07_Kelola_Produk
hide footbox
skinparam monochrome true
skinparam shadowing false

actor "Admin" as Admin
boundary "Halaman Produk" as View
control "Kontroler Produk" as Controller
database "Basis Data" as DB

Admin -> View : Mengakses menu produk
View -> Controller : Meminta daftar produk
activate Controller
Controller -> DB : Mengambil semua produk
activate DB
DB --> Controller : Data produk
deactivate DB
Controller --> View : Menampilkan tabel produk
deactivate Controller

alt [Tambah/Perbarui]
    Admin -> View : Mengirim formulir produk
    View -> Controller : Mengirim data produk
    activate Controller
    Controller -> DB : Menyimpan/Memperbarui produk
    Controller --> View : Mengarahkan kembali
    deactivate Controller
else [Hapus]
    Admin -> View : Klik hapus
    View -> Controller : Meminta penghapusan produk
    activate Controller
    Controller -> DB : Menghapus produk
    Controller --> View : Mengarahkan kembali
    deactivate Controller
end
@enduml

