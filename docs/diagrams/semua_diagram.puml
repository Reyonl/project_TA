@startuml 09_Review_Desain
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Admin" as Admin
actor "Pelanggan" as Customer
boundary "Detail Pesanan" as View
control "Kontroler Pesanan\n(Admin / Customer)" as Controller
boundary "Penyimpanan\n(Storage)" as Storage
entity "Basis Data" as DB

Admin -> View : Membuka detail pesanan & memeriksa mockup desain kustom

alt [Kondisi: Desain Memerlukan Revisi (Admin)]
    Admin -> View : Mengisi form catatan revisi & klik "Minta Revisi"
    View -> Controller : Request status_desain = 'revision_required' & catatan_admin
    activate Controller
    Controller -> DB : Update tabel order_details (status_desain: 'revision_required', catatan_admin)
    activate DB
    DB --> Controller : Status revisi tersimpan
    deactivate DB
    Controller --> View : Mengarahkan kembali dengan pesan sukses
    deactivate Controller
end

opt [Kondisi: Pelanggan Memperbaiki Desain]
    Customer -> View : Membuka detail pesanan & membaca catatan revisi Admin
    Customer -> View : Klik tombol "Perbaiki Sekarang"
    View --> Customer : Membuka Editor Desain dengan memuat JSON canvas_front/back
    Customer -> View : Melakukan perbaikan elemen desain & klik "Simpan Revisi"
    View -> Controller : Mengirim payload desain hasil revisi
    activate Controller
    Controller -> Storage : Menyimpan file gambar mockup perbaikan ke storage
    activate Storage
    Storage --> Controller : Path gambar baru
    deactivate Storage
    Controller -> DB : Insert data desain baru ke tabel desains (parent_id = id_desain_lama)
    activate DB
    Controller -> DB : Update order_details (id_desain = id_desain_baru, status_desain = 'pending')
    DB --> Controller : Data versi baru tersimpan
    deactivate DB
    Controller --> View : Mengarahkan kembali ke halaman pesanan dengan notifikasi sukses
    deactivate Controller
end

alt [Kondisi: Admin Menyetujui Desain]
    Admin -> View : Klik tombol "Setujui Desain"
    View -> Controller : Request status_desain = 'approved'
    activate Controller
    Controller -> DB : Update tabel order_details (status_desain = 'approved')
    activate DB
    DB --> Controller : Status desain disetujui
    deactivate DB
    Controller -> Controller : Cek apakah seluruh item desain pada order berstatus 'approved'
    opt [Semua Desain Approved & Status Order 'reviewing']
        Controller -> DB : Update tabel orders (status_order = 'pending_payment', payment_status = 'awaiting_payment')
        activate DB
        DB --> Controller : Status pesanan siap bayar
        deactivate DB
    end
    Controller --> View : Mengarahkan kembali dengan notifikasi sukses
    deactivate Controller
end
@enduml

@startuml 10_Kelola_Pesanan
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Admin" as Admin
boundary "Manajemen Pesanan" as View
control "Kontroler Pesanan" as Controller
entity "Basis Data\n(orders)" as DB

Admin -> View : Membuka menu daftar pesanan masuk
View -> Controller : Meminta data semua pesanan pelanggan
activate Controller
Controller -> DB : Mengambil data pesanan beserta relasi customer & item
activate DB
DB --> Controller : Data pesanan
deactivate DB
Controller --> View : Menampilkan tabel manajemen pesanan
deactivate Controller

alt [Verifikasi Pembayaran Transfer]
    Admin -> View : Memeriksa berkas bukti transfer & klik tombol verifikasi
    alt [Bukti Pembayaran Sah / Diterima]
        View -> Controller : Request verifyPayment (action = 'approve')
        activate Controller
        Controller -> DB : Update tabel orders (payment_status: 'paid', status_order: 'processing')
        activate DB
        DB --> Controller : Status terupdate
        deactivate DB
        Controller --> View : Mengarahkan kembali dengan pesan "Pembayaran diverifikasi, pesanan masuk produksi"
        deactivate Controller
    else [Bukti Pembayaran Tidak Sah / Ditolak]
        View -> Controller : Request verifyPayment (action = 'reject')
        activate Controller
        Controller -> DB : Update tabel orders (payment_status: 'failed', status_order: 'pending_payment')
        activate DB
        DB --> Controller : Status terupdate
        deactivate DB
        Controller --> View : Mengarahkan kembali dengan pesan "Pembayaran ditolak, pelanggan diminta upload ulang"
        deactivate Controller
    end
else [Pembaruan Status Produksi / Pengiriman]
    Admin -> View : Mengubah status pesanan ('processing' -> 'completed' / 'cancelled')
    View -> Controller : Mengirim update status_order
    activate Controller
    Controller -> DB : Memperbarui kolom status_order di tabel orders
    activate DB
    DB --> Controller : Status terupdate
    deactivate DB
    Controller --> View : Mengarahkan kembali & memuat status terbaru
    deactivate Controller
end
@enduml

@startuml 11_Laporan
hide footbox
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12

actor "Pemilik\n(Owner)" as Owner
boundary "Halaman Laporan\n(Browser)" as View
control "Kontroler Laporan" as Controller
entity "Basis Data" as DB

Owner -> View : Membuka modul laporan penjualan
Owner -> View : Memilih rentang filter tanggal (start_date, end_date) & klik "Filter"
View -> Controller : Mengirim request data laporan dengan parameter tanggal
activate Controller
Controller -> DB : Menjalankan agregasi (total transaksi, revenue completed, top produk, chart bulanan)
activate DB
DB --> Controller : Data ringkasan analitik penjualan
deactivate DB
Controller --> View : Menampilkan kartu KPI, grafik analitik, & tabel transaksi
deactivate Controller

alt [Ekspor Data ke File Excel / CSV]
    Owner -> View : Klik tombol "Download Excel"
    View -> Controller : Request ekspor data (export_csv = 1)
    activate Controller
    Controller -> DB : Mengambil seluruh data pesanan pada rentang tanggal
    activate DB
    DB --> Controller : Data transaksi lengkap
    deactivate DB
    Controller -> View : Mengirimkan response stream file CSV (Laporan_Penjualan_DailyCo_*.csv)
    deactivate Controller
    View --> Owner : Memicu unduhan file spreadsheet CSV/Excel otomatis
else [Cetak Dokumen Fisik / Simpan PDF]
    Owner -> View : Klik tombol "Surat Cetak"
    View -> View : Memicu fungsi pencetakan browser (window.print())
    note over View : Layout laporan diformat otomatis oleh CSS @media print\nlengkap dengan kop surat resmi DAILY.CO
    View --> Owner : Menampilkan kotak dialog cetak printer / Simpan sebagai PDF
end
@enduml
