    activate DB
    DB --> Controller : Data produk tersimpan
    deactivate DB
    Controller --> View : Mengarahkan kembali dengan notifikasi sukses
    deactivate Controller
else [Hapus Produk]
    Admin -> View : Klik tombol "Hapus" pada produk
    View -> Controller : Request penghapusan produk (id_produk)
    activate Controller
    Controller -> DB : Menghapus data produk dari tabel produks
    activate DB
    DB --> Controller : Data terhapus
    deactivate DB
    Controller --> View : Mengarahkan kembali & memuat ulang tabel produk
    deactivate Controller
end
@enduml

