@startuml activity_pemesanan
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam DefaultFontName Arial
skinparam DefaultFontSize 13

skinparam activity {
  BackgroundColor white
  BorderColor black
  FontColor black
}
skinparam activityDiamond {
  BackgroundColor white
  BorderColor black
}
skinparam arrowColor black
skinparam swimlane {
  BorderColor black
  BorderThickness 1
  TitleFontColor black
  TitleFontSize 16
}

|Pelanggan|
start
:Membuka Halaman Katalog;
:Memilih Produk Sablon;

if (Tipe Pemesanan?) then (Desain Sendiri)
  :Membuka Editor Desain (Wizard);
  :Memilih Warna Baju (Langkah 1);
  :Membuat Desain Depan (Langkah 2);
  :Membuat Desain Belakang (Langkah 3);
  :Menyimpan & Tinjau Harga (Langkah 4);
else (Produk Jadi)
  :Melihat Detail Produk;
endif

:Memasukkan ke Keranjang;
:Masuk Halaman Checkout;
:Transfer Manual & Unggah Bukti Pembayaran;
:Kirim & Konfirmasi Pembayaran;

|Sistem|
:Menyimpan Transaksi Pesanan & Mengosongkan Keranjang;

|Admin|
:Memvalidasi Pembayaran;
if (Desain Custom?) then (Ya)
  |Admin|
  :Memeriksa Detail Desain;
  if (Perlu Revisi?) then (Ya)
    :Tolak Desain & Kirim Catatan Revisi;
    |Pelanggan|
    :Menyunting Ulang Desain di Editor Canvas & Simpan;
    |Admin|
  else (Tidak)
  endif
  :Menyetujui Desain;
else (Tidak)
endif

|Admin|
:Memproses Sablon (Produksi);
:Mengirim Pesanan (Selesai);

|Pelanggan|
:Menerima Pesanan;
stop
@enduml
