@startuml act_04_Checkout_Pesanan
skinparam Style strictuml
skinparam ActivityFontName Times New Roman
skinparam ActivityFontSize 12
skinparam ActivityBorderColor Black
skinparam ActivityBackgroundColor White
skinparam ArrowColor Black
skinparam ArrowFontName Times New Roman
skinparam ArrowFontSize 10
skinparam SwimlaneBorderColor Black
skinparam SwimlaneTitleFontName Times New Roman
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold

|Pelanggan|
start
:Memilih Item Belanja & Klik Checkout;

|Sistem|
:Menampilkan Ringkasan Tagihan & Nomor Rekening Bank BCA;

|Pelanggan|
:Melakukan Transfer Dana secara Manual\n(<<include>> Lakukan Pembayaran);
:Mengambil Foto / Screenshot Bukti Transfer;
:Mengunggah Berkas Bukti Pembayaran ke Formulir;
:Klik Tombol "Kirim & Konfirmasi Pembayaran";

|Sistem|
:Memvalidasi File Bukti Pembayaran;
if (Berkas Valid?) then (Ya)
  :Memulai Transaksi Basis Data (DB::transaction);
  :Mengunggah File Bukti Transfer ke Storage;
  :Membuat Record Order Baru (status_order: 'pending');
  :Membuat Record Detail Order di 'order_details';
  :Menghapus Item Belanja Terpilih dari Keranjang ('carts');
  :Menyelesaikan Transaksi Basis Data;
  :Mengarahkan ke Halaman Riwayat Pesanan;
  |Pelanggan|
  :Menampilkan Notifikasi Sukses & Riwayat Pesanan;
  stop
else (Tidak)
  |Sistem|
  :Mengarahkan Kembali ke Halaman Checkout;
  :Menampilkan Pesan Kesalahan Format / Ukuran File;
  |Pelanggan|
  :Melihat Pesan Error & Mengunggah Ulang File;
  stop
endif
@enduml
